# ==============================================================================
# LLM Providers (Choose one or set multiple)
# ==============================================================================

# Option A: Google AI Studio (Recommended Free Tier)
# Get a free key here: https://aistudio.google.com/
# Gemini 2.5 Flash is free with generous rate limits.
GEMINI_API_KEY=

# Option B: OpenAI
# Get a key here: https://platform.openai.com/
OPENAI_API_KEY=

# Option C: OpenRouter (Default Paid/Free)
# Get a key here: https://openrouter.ai/keys
# You can use free model slugs like 'google/gemini-2.5-flash:free' without adding credits.
OPENROUTER_API_KEY=

# Option D: Ollama (100% Local / Free)
# Just install and run Ollama locally: https://ollama.com/
# No API key is needed. Default model is 'llama3'.


# ==============================================================================
# Search & Discovery Providers (Choose one or leave blank for keyless)
# ==============================================================================

# Option A: Tavily Search (Recommended Free Tier - 1,000 queries/month)
# Get a free key here: https://tavily.com/
TAVILY_API_KEY=

# Option B: Parallel (Paid Search / Extraction)
# Get a key here: https://platform.parallel.ai/
PARALLEL_API_KEY=

# Option C: DuckDuckGo Search (100% Free / Keyless)
# If both TAVILY_API_KEY and PARALLEL_API_KEY are empty, DuckDuckGo is used automatically.
# No key required.


# ==============================================================================
# Optional Configuration Overrides
# ==============================================================================

# LLM Provider override: auto (default), gemini, openai, ollama, openrouter
# MIMEO_LLM_PROVIDER=auto

# Search Provider override: auto (default), tavily, parallel, duckduckgo
# MIMEO_SEARCH_PROVIDER=auto

# LLM Model override (default depends on your provider)
# MIMEO_MODEL=gemini-2.5-flash

# OpenRouter attribution headers (only relevant if using OpenRouter)
# OPENROUTER_SITE_URL=https://github.com/you/mimeo
# OPENROUTER_APP_NAME=mimeo
